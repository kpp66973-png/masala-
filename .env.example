# MASALA Restaurant Configuration

# Frontend API URL (leave empty in single-container deployment to use same host; set when frontend is deployed separately)
VITE_API_URL=

# PostgreSQL Database Connection String (for Supabase / Neon / Railway external deployments)
# (Note: In Google AI Studio, Cloud SQL platform environment variables SQL_HOST, SQL_USER, SQL_PASSWORD, SQL_DB_NAME are automatically injected)
DATABASE_URL=

# Razorpay Payment Gateway Credentials
# Get your Key ID and Secret from https://dashboard.razorpay.com/app/keys
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Admin Dashboard Passcode (default is masala_admin_2026 if not set)
ADMIN_SECRET=masala_admin_2026
ADMIN_EMAIL=kpp66973@gmail.com

# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"
